{
  "name": "@cardano-ibc/proto-types",
  "version": "0.9.0",
  "description": "Protocol Buffer definitions and generated TypeScript bindings for Cardano IBC",
  "contributors": [
    "Simon Warta <webmaster128@users.noreply.github.com>",
    "Will Clark <willclarktech@users.noreply.github.com>",
    "Dan Lynch <pyramation@gmail.com>"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardano-foundation/cardano-ibc-incubator.git",
    "directory": "proto-types"
  },
  "bugs": {
    "url": "https://github.com/cardano-foundation/cardano-ibc-incubator/issues"
  },
  "homepage": "https://github.com/cardano-foundation/cardano-ibc-incubator/tree/main/proto-types#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "cosmos/",
    "cosmos_proto/",
    "cosmwasm/",
    "gogoproto/",
    "google/",
    "ibc/",
    "tendermint/",
    "vesseloracle/",
    "/binary.*",
    "/helpers.*",
    "/utf8.*",
    "/varint.*",
    "/index.*",
    "*.md",
    "!wasmd-*/**/*.md",
    "!cosmos-sdk-*/**/*.md"
  ],
  "scripts": {
    "format": "prettier --write --loglevel warn \"./src/**/*.ts\" \"./scripts/**/*.js\"",
    "codegen": "rm -rf ./src && ./scripts/codegen.js && npm run format",
    "prepare-publishing": "./scripts/prepare-publishing.sh",
    "build": "rm -rf ./build && tsc && npm run prepare-publishing"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15"
  },
  "devDependencies": {
    "@cosmology/telescope": "^2.1.0",
    "@types/node": "^15.6.2",
    "prettier": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.2"
  },
  "overrides": {
    "glob": "10.5.0",
    "minimatch": "5.1.9",
    "protobufjs": "7.6.5",
    "tmp": "0.2.7"
  }
}
