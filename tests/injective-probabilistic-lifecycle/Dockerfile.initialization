# syntax=docker/dockerfile:1
ARG INJECTIVE_BUILDER_IMAGE=local/injective-bounded-verification-builder
FROM ${INJECTIVE_BUILDER_IMAGE} AS build
COPY cosmos/cardano-probabilistic-light-client-core /release/cosmos/cardano-probabilistic-light-client-core
COPY cosmos/cardano-probabilistic-light-client-v8 /release/cosmos/cardano-probabilistic-light-client-v8
COPY chains/cosmos/patch_cardano_probabilistic_light_client.sh /release/patch.sh
RUN sh /release/patch.sh /injective /release
COPY --from=probe_src / /injective/cmd/cardano-release-probe
RUN --mount=type=tmpfs,target=/tmp --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg/mod \
    GOTOOLCHAIN=go1.26.9 GOWORK=off go build -mod=mod -ldflags="-s -w" -o /usr/local/bin/cardano-release-probe ./cmd/cardano-release-probe
ENV LD_LIBRARY_PATH=/usr/local/lib
ENTRYPOINT ["cardano-release-probe"]
