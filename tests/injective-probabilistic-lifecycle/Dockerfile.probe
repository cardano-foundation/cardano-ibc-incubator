# syntax=docker/dockerfile:1
ARG INJECTIVE_BUILDER_IMAGE=local/cardano-injective-release-builder
ARG INJECTIVE_IMAGE=local/cardano-injective-release
FROM ${INJECTIVE_BUILDER_IMAGE} AS builder
COPY probe /injective/cmd/cardano-release-probe
RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    GOWORK=off go build -ldflags="-s -w" -mod=readonly -o /usr/local/bin/cardano-release-probe ./cmd/cardano-release-probe
FROM builder AS bounded-probe
ENV LD_LIBRARY_PATH=/usr/local/lib
ENTRYPOINT ["cardano-release-probe"]

FROM ${INJECTIVE_IMAGE} AS probe
COPY --from=builder /usr/local/bin/cardano-release-probe /usr/local/bin/cardano-release-probe
ENTRYPOINT ["cardano-release-probe"]
