#!/usr/bin/env sh
set -eu

if [ -n "${CARDANO_LOCAL_CLOCK_FILE:-}" ]; then
  # Disposable rehearsal only: one shared offset file advances the existing
  # processes without restarting all producers at every small clock step.
  test -r "$CARDANO_LOCAL_CLOCK_FILE"
  export FAKETIME_TIMESTAMP_FILE="$CARDANO_LOCAL_CLOCK_FILE"
  export FAKETIME_NO_CACHE=1
  unset FAKETIME
else
  target_seconds="$(date -u -d "${CARDANO_LOCAL_CLOCK_TARGET:-2025-12-31 23:59:10}" +%s)"
  current_seconds="$(date -u +%s)"
  export FAKETIME="$((target_seconds - current_seconds))s"
fi

for faketime_lib in /usr/lib/*/faketime/libfaketime.so.1; do
  if [ -r "$faketime_lib" ]; then
    export LD_PRELOAD="$faketime_lib"
    break
  fi
done

exec /usr/local/bin/entrypoint "$@"
