# Optional host port overrides, copy to .env before the first start.
# Existing instances retain their settings until `caribic devkit reset`.
DEVKIT_ADMIN_PORT=10080
DEVKIT_NODE_PORT=13001
DEVKIT_OGMIOS_PORT=11337
DEVKIT_KUPO_PORT=11442
DEVKIT_HISTORY_PORT=18081
DEVKIT_HISTORY_DB_PORT=15432
# Host used in the generated endpoint file, containers publish on loopback.
DEVKIT_HOST=127.0.0.1
