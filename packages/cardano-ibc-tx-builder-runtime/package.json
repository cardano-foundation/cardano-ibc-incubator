{
  "name": "@cardano-ibc/tx-builder-runtime",
  "version": "0.1.0",
  "description": "Runtime Cardano IBC transaction builder integration helpers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardano-foundation/cardano-ibc-incubator.git",
    "directory": "packages/cardano-ibc-tx-builder-runtime"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./ics23MerkleTree": { "types": "./dist/ics23MerkleTree.d.ts", "default": "./dist/ics23MerkleTree.js" },
    "./ibcStateRoot": { "types": "./dist/ibcStateRoot.d.ts", "default": "./dist/ibcStateRoot.js" },
    "./consensusHistory": { "types": "./dist/consensusHistory.d.ts", "default": "./dist/consensusHistory.js" },
    "./consensusHistoryRecovery": { "types": "./dist/consensusHistoryRecovery.d.ts", "default": "./dist/consensusHistoryRecovery.js" },
    "./consensusHistoryYaci": { "types": "./dist/consensusHistoryYaci.d.ts", "default": "./dist/consensusHistoryYaci.js" },
    "./incrementalIbcTree": { "types": "./dist/incrementalIbcTree.d.ts", "default": "./dist/incrementalIbcTree.js" },
    "./plutusSerialise": { "types": "./dist/plutusSerialise.d.ts", "default": "./dist/plutusSerialise.js" },
    "./transferEscrowShard": { "types": "./dist/transferEscrowShard.d.ts", "default": "./dist/transferEscrowShard.js" },
    "./sendPacketEscrow": { "types": "./dist/sendPacketEscrow.d.ts", "default": "./dist/sendPacketEscrow.js" }
  },
  "typesVersions": {
    "*": {
      "ics23MerkleTree": ["dist/ics23MerkleTree.d.ts"],
      "ibcStateRoot": ["dist/ibcStateRoot.d.ts"],
      "consensusHistory": ["dist/consensusHistory.d.ts"],
      "consensusHistoryRecovery": ["dist/consensusHistoryRecovery.d.ts"],
      "consensusHistoryYaci": ["dist/consensusHistoryYaci.d.ts"],
      "incrementalIbcTree": ["dist/incrementalIbcTree.d.ts"],
      "plutusSerialise": ["dist/plutusSerialise.d.ts"],
      "transferEscrowShard": ["dist/transferEscrowShard.d.ts"],
      "sendPacketEscrow": ["dist/sendPacketEscrow.d.ts"]
    }
  },
  "files": [
    "dist",
    "!dist/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/*.test.js"
  },
  "overrides": {
    "@lucid-evolution/uplc": "0.2.23"
  },
  "dependencies": {
    "@cardano-ibc/trace-registry": "file:../cardano-ibc-trace-registry",
    "@cardano-ibc/tx-builder": "file:../cardano-ibc-tx-builder",
    "@harmoniclabs/bytestring": "^1.0.0",
    "@harmoniclabs/cbor": "^1.6.6",
    "@harmoniclabs/crypto": "^0.3.0",
    "@harmoniclabs/pair": "^1.0.0",
    "@lucid-evolution/lucid": "^0.4.29",
    "@noble/hashes": "^1.8.0",
    "js-sha256": "^0.11.0",
    "js-sha3": "^0.9.3",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@cardano-ibc/trace-registry": "0.1.0",
    "@cardano-ibc/tx-builder": "0.1.0",
    "@harmoniclabs/bytestring": "^1.0.0",
    "@harmoniclabs/cbor": "^1.6.6",
    "@harmoniclabs/crypto": "^0.3.0",
    "@harmoniclabs/pair": "^1.0.0",
    "@lucid-evolution/lucid": "^0.4.29",
    "@noble/hashes": "^1.8.0",
    "js-sha256": "^0.11.0",
    "js-sha3": "^0.9.3",
    "ws": "^8.18.2"
  }
}
