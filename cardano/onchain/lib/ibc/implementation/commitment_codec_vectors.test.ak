      versions: [
        Version {
          identifier: "1",
          features: ["ORDER_ORDERED", "ORDER_UNORDERED"],
        },
      ],
      state: connection_state.Uninitialized,
      counterparty: Counterparty {
        client_id: "07-tendermint-9",
        connection_id: "connection-2",
        prefix: MerklePrefix { key_prefix: "ibc" },
      },
      delay_period: 0,
