test registration() {
  codec.encode_registration(
    ModuleRegistration {
      module_script_hash: #"33333333333333333333333333333333333333333333333333333333",
      port_token: AuthToken {
        policy_id: #"44444444444444444444444444444444444444444444444444444444",
        name: "port",
      },
      module_token: AuthToken {
        policy_id: #"55555555555555555555555555555555555555555555555555555555",
        name: "module",
      },
    },
  ) == #"d8799f581c33333333333333333333333333333333333333333333333333333333d8799f581c4444444444444444444444444444444444444444444444444444444444706f7274ffd8799f581c55555555555555555555555555555555555555555555555555555555466d6f64756c65ffff"
