    state,
    ordering: Unordered,
    counterparty: ChannelCounterparty {
      port_id: "transfer",
      channel_id: "channel-2",
    },
    connection_hops: [connection_hop],
    version: "ics20-1",
    upgrade_sequence: sequence,
  }
}

fn upgrade_fields() -> UpgradeFields {
  UpgradeFields {
    ordering: Unordered,
    connection_hops: ["connection-1"],
    version: "ics20-1",
  }
}

