// Replays the first-ever second-transfer SendPacket on preprod (2026-07-28):
// spending the existing transfer escrow shard on channel-5. All datums,
// redeemers, values, and validator parameters are the exact on-chain /
// captured bytes. This path crashed with a bare error until the off-chain
// ICS-20 packet JSON was aligned with the on-chain alphabetical marshal.

use aiken/cbor
use aiken/interval
use cardano/address.{Address, Inline, Script, VerificationKey}
use cardano/assets
use cardano/transaction.{
  InlineDatum, Input, Mint, NoDatum, Output, OutputReference, Spend, Transaction,
  placeholder,
}
use ibc/auth.{AuthToken}
use ibc/core/ics_005/types/ibc_module_redeemer.{IBCModuleRedeemer}
use spending_transfer_module

fn datum_data(bytes: ByteArray) -> Data {
  expect Some(d) = cbor.deserialise(bytes)
  d
}

test preprod_second_transfer_shard_spend_repro() fail {
  let hoststate_addr =
    Address {
      payment_credential: Script(
        #"f594092fa8b22a91e6c4a5c038babb5c739d6ef1481507a0c776d925",
      ),
      stake_credential: None,
    }
  let channel_addr =
    Address {
      payment_credential: Script(
        #"2056eef5ebff4c55ae6b6e5390d440963351554fd808ef61d85c2ef2",
      ),
      stake_credential: None,
    }
  let shard_addr =
    Address {
      payment_credential: Script(
        #"e4068c20d3969e084b8f8c37d2ab5d95aa98665e83e95d15cfad9d45",
      ),
      stake_credential: None,
    }
  let wallet_addr =
    Address {
      payment_credential: VerificationKey(
        #"2f5dd2da9bd8abfb0800cbd1e9927e92e12e7ab936df65eb51e6bca1",
      ),
      stake_credential: Some(
        Inline(
          VerificationKey(
            #"0f04b47f1e803c62cf2151f26b3dd58539f5c63248dd500e1d31ceb5",
          ),
        ),
      ),
    }

  let wallet_in =
    Input {
      output_reference: OutputReference {
        transaction_id: #"81ccd007c1136c780f6fca50f359ddbdaf3b7939c430df962e7fcc37f71e50b7",
        output_index: 0,
      },
      output: Output {
        address: wallet_addr,
        value: assets.from_lovelace(10000000000),
        datum: NoDatum,
        reference_script: None,
      },
    }
  let hoststate_in =
    Input {
      output_reference: OutputReference {
        transaction_id: #"87058859a7c1fc0ded3cfefc4c2f07748b39b546ef0d9e3984d7561e9950ef29",
        output_index: 0,
      },
      output: Output {
        address: hoststate_addr,
        value: assets.from_lovelace(1633490)
          |> assets.add(
              #"8c45ce9ea37ce524017c80e80df7764674be7a83ca47bd67f4598eec",
              #"6962635f686f73745f7374617465",
              1,
            ),
        datum: InlineDatum(
          datum_data(
            #"d87984d8798718275820e152ccc5b78c705913d9ddebc0fd296ec0b7cc5658a055a65167c3288a301dc1020506831863186418651b0000019fa31e9cdf581c8c45ce9ea37ce524017c80e80df7764674be7a83ca47bd67f4598eec581caffd4f9f03fd297fe390b55e8d355b43db0d81a8f70ce7c3c306603dd87980",
          ),
        ),
        reference_script: None,
      },
    }
  let channel_in =
    Input {
      output_reference: OutputReference {
        transaction_id: #"87058859a7c1fc0ded3cfefc4c2f07748b39b546ef0d9e3984d7561e9950ef29",
        output_index: 1,
      },
      output: Output {
        address: channel_addr,
        value: assets.from_lovelace(1745550)
          |> assets.add(
              #"28863c8385688fdc92b2a95956755e93de52a0ab5934faccece63ee9",
              #"0424b13cd3ffa680a578c4834f86a05a25e98ad7239b722035",
              1,
            ),
        datum: InlineDatum(
          datum_data(
            #"d87983d87987d87985d87c80d87a80d87982487472616e736665724d6368616e6e656c2d3737313330814c636f6e6e656374696f6e2d344769637332302d31020101a0a0a0487472616e73666572d87982581c28863c8385688fdc92b2a95956755e93de52a0ab5934faccece63ee958190424b13cd3ffa680a578c4834f86a05a25e98ad7239b722035",
          ),
        ),
        reference_script: None,
      },
    }
  let shard_in =
    Input {
      output_reference: OutputReference {
        transaction_id: #"ef2379f14e919909890298bc94610dc99fe8ae862469c821628404959a1b4785",
        output_index: 2,
      },
      output: Output {
        address: shard_addr,
        value: assets.from_lovelace(2000000)
          |> assets.add(
              #"762c93f572a43fed7d53b0069cbc23b6648fb44dc58d1d6e76a4eb72",
              #"321dcc99ec01abcd4823ae33cb488bab8200698cbd3930752fdb1db1",
              1,
            ),
        datum: InlineDatum(
          datum_data(
            #"d87982496368616e6e656c2d355036633666373636353663363136333635",
          ),
        ),
        reference_script: None,
      },
    }
  let inputs = [wallet_in, hoststate_in, channel_in, shard_in]

  let out0 =
    Output {
      address: hoststate_addr,
      value: assets.from_lovelace(1633490)
        |> assets.add(
            #"8c45ce9ea37ce524017c80e80df7764674be7a83ca47bd67f4598eec",
            #"6962635f686f73745f7374617465",
            1,
          ),
      datum: InlineDatum(
        datum_data(
          #"d87984d87987182858207511a331bf2f896ddcc2181372fd78397b7a53667ead6b627938df5da65bf7dd020506831863186418651b0000019fa7a8a007581c8c45ce9ea37ce524017c80e80df7764674be7a83ca47bd67f4598eec581caffd4f9f03fd297fe390b55e8d355b43db0d81a8f70ce7c3c306603dd87980",
        ),
      ),
      reference_script: None,
    }
  let out1 =
    Output {
      address: channel_addr,
      value: assets.from_lovelace(1896400)
        |> assets.add(
            #"28863c8385688fdc92b2a95956755e93de52a0ab5934faccece63ee9",
            #"0424b13cd3ffa680a578c4834f86a05a25e98ad7239b722035",
            1,
          ),
      datum: InlineDatum(
        datum_data(
          #"",
        ),
      ),
      reference_script: None,
    }
  let out2 =
    Output {
      address: shard_addr,
      value: assets.from_lovelace(17000000)
        |> assets.add(
            #"762c93f572a43fed7d53b0069cbc23b6648fb44dc58d1d6e76a4eb72",
            #"321dcc99ec01abcd4823ae33cb488bab8200698cbd3930752fdb1db1",
            1,
          ),
      datum: InlineDatum(
        datum_data(
          #"d87982496368616e6e656c2d355036633666373636353663363136333635",
        ),
      ),
      reference_script: None,
    }
  let out3 =
    Output {
      address: wallet_addr,
      value: assets.from_lovelace(9983731397)
        |> assets.add(
            #"31cb278a1cf34b8aa0d343f18116b9cce4204b658b603290c7883d4c",
            #"",
            1,
          ),
      datum: NoDatum,
      reference_script: None,
    }
  let outputs = [out0, out1, out2, out3]

  let hoststate_red =
    datum_data(
      #"",
    )
  let channel_red =
    datum_data(
      #"",
    )
  let module_red =
    datum_data(
      #"",
    )
  let mint_red =
    datum_data(
      #"d8799f581c28863c8385688fdc92b2a95956755e93de52a0ab5934faccece63ee958190424b13cd3ffa680a578c4834f86a05a25e98ad7239b722035ff",
    )
  let redeemers =
    [
      Pair(Spend(hoststate_in.output_reference), hoststate_red),
      Pair(Spend(channel_in.output_reference), channel_red),
      Pair(Spend(shard_in.output_reference), module_red),
      Pair(
        Mint(#"31cb278a1cf34b8aa0d343f18116b9cce4204b658b603290c7883d4c"),
        mint_red,
      ),
    ]

  let tx =
    Transaction {
      ..placeholder,
      inputs,
      outputs,
      redeemers,
      mint: assets.from_asset(
        #"31cb278a1cf34b8aa0d343f18116b9cce4204b658b603290c7883d4c",
        #"",
        1,
      ),
      validity_range: interval.between(1785224273000, 1785224873000),
    }

  expect typed_module_red: IBCModuleRedeemer = module_red
  let port_token =
    AuthToken {
      policy_id: #"17a284a964f3ba5284a0e4b6e40a0c9567071232944d1491f5fd67a8",
      name: #"0424b13cd3ffa680a578c4834f86a05a25e98ad75a6e59fc313030",
    }
  let module_token =
    AuthToken {
      policy_id: #"2f2694b6e83ae30aa28966529b2fe0cfa2d2bf5028b0f75f1ac92a88",
      name: #"b428ace988dc5ed617737f0cd3456c77171741959c2364295b190a55cfc77eb0",
    }

  spending_transfer_module.spend_transfer_module.spend(
    port_token,
    module_token,
    "port-100",
    #"762c93f572a43fed7d53b0069cbc23b6648fb44dc58d1d6e76a4eb72",
    #"28863c8385688fdc92b2a95956755e93de52a0ab5934faccece63ee9",
    #"a891e396eace4295e3affc0e65eb804408ae7796f9f9254321763afc",
    #"8c45ce9ea37ce524017c80e80df7764674be7a83ca47bd67f4598eec",
    Some(
      datum_data(
        #"d87982496368616e6e656c2d355036633666373636353663363136333635",
      ),
    ),
    typed_module_red,
    shard_in.output_reference,
