// Replays the first observed TimeoutPacket unescrow attempt on preprod
// (channel-6 seq 1, captured 2026-07-28 from the gateway failure dump).
// All bytes are the exact on-chain / captured values. The module refund
// path fails for legacy packets whose ICS-20 JSON was struct-ordered
// (denom-first) and whose sender is a 29-byte address-hex: the deployed
// validator marshals alphabetically and treats sender as a bare key hash.
// Expected failing checks (in order encountered):
//   1. validate_refund_packet_token receiver delta (sender parsed as
//      29-byte "key hash" matches no output; fee also debits the wallet)
//   2. fungible_token_packet_data.get_bytes(data) != packet.data

use aiken/cbor
use aiken/interval
use cardano/address.{Address, Script, VerificationKey}
use cardano/assets
use cardano/transaction.{
  InlineDatum, Input, Mint, NoDatum, Output, OutputReference, Spend,
  Transaction, placeholder,
}
use ibc/auth.{AuthToken}
use ibc/core/ics_005/types/ibc_module_redeemer.{IBCModuleRedeemer}
use spending_transfer_module

fn datum_data(bytes: ByteArray) -> Data {
  expect Some(d) = cbor.deserialise(bytes)
  d
}

test preprod_timeout_unescrow_repro() fail {
  let hoststate_in = Input {
    output_reference: OutputReference { transaction_id: #"e4bf6f473a8795486403f6a5b2fa6624cb9d6533404804d4573084a22b4bf9ad", output_index: 0 },
    output: Output {
      address: Address { payment_credential: Script(#"f594092fa8b22a91e6c4a5c038babb5c739d6ef1481507a0c776d925"), stake_credential: None },
      value: assets.from_lovelace(1633490)
        |> assets.add(#"8c45ce9ea37ce524017c80e80df7764674be7a83ca47bd67f4598eec", #"6962635f686f73745f7374617465", 1),
      datum: InlineDatum(datum_data(#"d87984d87987183658201150b3e751f90f9f750585b07c298900c5da6218c27a3d65e3f84e8aaa64aebd020607831863186418651b0000019fa96efcc9581c8c45ce9ea37ce524017c80e80df7764674be7a83ca47bd67f4598eec581caffd4f9f03fd297fe390b55e8d355b43db0d81a8f70ce7c3c306603dd87980")),
      reference_script: None,
    },
  }
  let wallet_in = Input {
    output_reference: OutputReference { transaction_id: #"e4bf6f473a8795486403f6a5b2fa6624cb9d6533404804d4573084a22b4bf9ad", output_index: 2 },
    output: Output {
      address: Address { payment_credential: VerificationKey(#"affd4f9f03fd297fe390b55e8d355b43db0d81a8f70ce7c3c306603d"), stake_credential: None },
      value: assets.from_lovelace(4198227626)
        |> assets.add(#"def68337867cb4f1f95b6b811fedbfcdd7780d10a95cc072077088ea", #"6d6f636b", 54000000000)
        |> assets.add(#"1f277ef5259c1ee47050efcbcba49ec0e2d01e68b6118f6989a18ea8", #"", 1)
        |> assets.add(#"31cb278a1cf34b8aa0d343f18116b9cce4204b658b603290c7883d4c", #"", 3)
        |> assets.add(#"d053f828a3e3473dfcbe41384470b61b5cccf12d68c614f8cc81e781", #"", 10)
        |> assets.add(#"deb5d51b94e055f96c44fb511c9611904192e55ff17a137a2842e128", #"", 4),
      datum: NoDatum,
      reference_script: None,
    },
  }
  let channel_in = Input {
    output_reference: OutputReference { transaction_id: #"f200e78fd589cc83d7db870a48ac2a611a3c4ea01cbac5869f8418babb70cb81", output_index: 1 },
    output: Output {
      address: Address { payment_credential: Script(#"2056eef5ebff4c55ae6b6e5390d440963351554fd808ef61d85c2ef2"), stake_credential: None },
      value: assets.from_lovelace(2198100)
        |> assets.add(#"28863c8385688fdc92b2a95956755e93de52a0ab5934faccece63ee9", #"0424b13cd3ffa680a578c4834f86a05a25e98ad7239b722036", 1),
      datum: InlineDatum(datum_data(#"")),
      reference_script: None,
    },
  }
  let shard_in = Input {
    output_reference: OutputReference { transaction_id: #"f200e78fd589cc83d7db870a48ac2a611a3c4ea01cbac5869f8418babb70cb81", output_index: 2 },
    output: Output {
      address: Address { payment_credential: Script(#"e4068c20d3969e084b8f8c37d2ab5d95aa98665e83e95d15cfad9d45"), stake_credential: None },
      value: assets.from_lovelace(19000000)
        |> assets.add(#"762c93f572a43fed7d53b0069cbc23b6648fb44dc58d1d6e76a4eb72", #"665e61ab7a3d72c78233cbc0f4f29f1a955c2803220a4918613e0a47", 1),
      datum: InlineDatum(datum_data(#"d87982496368616e6e656c2d365036633666373636353663363136333635")),
      reference_script: None,
    },
  }
  let inputs = [hoststate_in, wallet_in, channel_in, shard_in]

  let out0 = Output {
    address: Address { payment_credential: Script(#"f594092fa8b22a91e6c4a5c038babb5c739d6ef1481507a0c776d925"), stake_credential: None },
    value: assets.from_lovelace(1633490)
        |> assets.add(#"8c45ce9ea37ce524017c80e80df7764674be7a83ca47bd67f4598eec", #"6962635f686f73745f7374617465", 1),
    datum: InlineDatum(datum_data(#"d87984d87987183758201d37ceb72a12e30d5e234d577016ffbc09f671b5bae53fc782276453c3fddb0f020607831863186418651b0000019fa9a0308e581c8c45ce9ea37ce524017c80e80df7764674be7a83ca47bd67f4598eec581caffd4f9f03fd297fe390b55e8d355b43db0d81a8f70ce7c3c306603dd87980")),
    reference_script: None,
  }
  let out1 = Output {
    address: Address { payment_credential: Script(#"2056eef5ebff4c55ae6b6e5390d440963351554fd808ef61d85c2ef2"), stake_credential: None },
    value: assets.from_lovelace(2047250)
        |> assets.add(#"28863c8385688fdc92b2a95956755e93de52a0ab5934faccece63ee9", #"0424b13cd3ffa680a578c4834f86a05a25e98ad7239b722036", 1),
    datum: InlineDatum(datum_data(#"")),
    reference_script: None,
  }
  let out2 = Output {
    address: Address { payment_credential: VerificationKey(#"affd4f9f03fd297fe390b55e8d355b43db0d81a8f70ce7c3c306603d"), stake_credential: None },
    value: assets.from_lovelace(2000000),
    datum: NoDatum,
    reference_script: None,
  }
  let out3 = Output {
    address: Address { payment_credential: Script(#"e4068c20d3969e084b8f8c37d2ab5d95aa98665e83e95d15cfad9d45"), stake_credential: None },
    value: assets.from_lovelace(17000000)
        |> assets.add(#"762c93f572a43fed7d53b0069cbc23b6648fb44dc58d1d6e76a4eb72", #"665e61ab7a3d72c78233cbc0f4f29f1a955c2803220a4918613e0a47", 1),
    datum: InlineDatum(datum_data(#"d87982496368616e6e656c2d365036633666373636353663363136333635")),
    reference_script: None,
  }
  let out4 = Output {
    address: Address { payment_credential: VerificationKey(#"affd4f9f03fd297fe390b55e8d355b43db0d81a8f70ce7c3c306603d"), stake_credential: None },
    value: assets.from_lovelace(4196885310)
        |> assets.add(#"def68337867cb4f1f95b6b811fedbfcdd7780d10a95cc072077088ea", #"6d6f636b", 54000000000)
        |> assets.add(#"1f277ef5259c1ee47050efcbcba49ec0e2d01e68b6118f6989a18ea8", #"", 1)
        |> assets.add(#"31cb278a1cf34b8aa0d343f18116b9cce4204b658b603290c7883d4c", #"", 3)
        |> assets.add(#"d053f828a3e3473dfcbe41384470b61b5cccf12d68c614f8cc81e781", #"", 11)
        |> assets.add(#"deb5d51b94e055f96c44fb511c9611904192e55ff17a137a2842e128", #"", 4)
        |> assets.add(#"0528e244619985824d6e5bbf24e6269c21f9c21e8fd6a39c944a06af", #"", 1),
    datum: NoDatum,
    reference_script: None,
  }
  let outputs = [out0, out1, out2, out3, out4]

  let hoststate_red = datum_data(#"")
  let channel_red = datum_data(#"")
  // NOTE: on-chain the empty memo is definite `40`; Aiken stdlib cbor.deserialise
  // rejects bare empty bytestrings, so it is re-encoded indefinite `5fff`
  // (identical decoded Data).
  let module_red = datum_data(#"")
  let timeout_mint_red = datum_data(#"d87982581c28863c8385688fdc92b2a95956755e93de52a0ab5934faccece63ee958190424b13cd3ffa680a578c4834f86a05a25e98ad7239b722036")
  let verify_mint_red = datum_data(#"")
  let redeemers = [
    Pair(Spend(hoststate_in.output_reference), hoststate_red),
    Pair(Spend(channel_in.output_reference), channel_red),
    Pair(Spend(shard_in.output_reference), module_red),
    Pair(Mint(#"0528e244619985824d6e5bbf24e6269c21f9c21e8fd6a39c944a06af"), timeout_mint_red),
    Pair(Mint(#"d053f828a3e3473dfcbe41384470b61b5cccf12d68c614f8cc81e781"), verify_mint_red),
  ]

  let tx = Transaction {
    ..placeholder,
    inputs: inputs,
    outputs: outputs,
    redeemers: redeemers,
    mint: assets.from_asset(#"0528e244619985824d6e5bbf24e6269c21f9c21e8fd6a39c944a06af", #"", 1)
      |> assets.add(#"d053f828a3e3473dfcbe41384470b61b5cccf12d68c614f8cc81e781", #"", 1),
    validity_range: interval.between(1785257274000, 1785257394000),
  }

  expect typed_module_red: IBCModuleRedeemer = module_red
  let port_token = AuthToken { policy_id: #"17a284a964f3ba5284a0e4b6e40a0c9567071232944d1491f5fd67a8", name: #"0424b13cd3ffa680a578c4834f86a05a25e98ad75a6e59fc313030" }
  let module_token = AuthToken { policy_id: #"2f2694b6e83ae30aa28966529b2fe0cfa2d2bf5028b0f75f1ac92a88", name: #"b428ace988dc5ed617737f0cd3456c77171741959c2364295b190a55cfc77eb0" }

  spending_transfer_module.spend_transfer_module.spend(
    port_token,
    module_token,
    "port-100",
    #"762c93f572a43fed7d53b0069cbc23b6648fb44dc58d1d6e76a4eb72",
    #"28863c8385688fdc92b2a95956755e93de52a0ab5934faccece63ee9",
    #"a891e396eace4295e3affc0e65eb804408ae7796f9f9254321763afc",
    #"8c45ce9ea37ce524017c80e80df7764674be7a83ca47bd67f4598eec",
    Some(datum_data(#"d87982496368616e6e656c2d365036633666373636353663363136333635")),
    typed_module_red,
    shard_in.output_reference,
    tx,
  )
}
