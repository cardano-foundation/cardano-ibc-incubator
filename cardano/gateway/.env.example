PORT=8000
# Standalone default. Docker Compose overrides the container bind address to
# 0.0.0.0 while publishing the port on host loopback only.
GRPC_HOST=127.0.0.1
GRPC_PORT=5001
# Optional TLS for a directly exposed Gateway. Configure both files or neither.
# Paths are resolved inside the Gateway process/container.
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
# Optional bearer-token protection for transaction-building and submission RPCs.
GRPC_AUTH_TOKEN_FILE=
# Docker publishes plaintext gRPC on loopback by default. Set this only when TLS
# or another trusted transport boundary protects the published port.
GRPC_PUBLISH_HOST=127.0.0.1

# Shared per-process budget for HTTP and RPC handlers. Both must be positive integers.
# Requests per second, with a burst allowance of the same size.
GATEWAY_API_RATE_LIMIT=100
# Handlers still running after a client disconnect count towards this limit.
GATEWAY_API_MAX_CONCURRENT=8

# Opt-in detailed transaction and packet diagnostics, disabled by default.
GATEWAY_DEBUG_DIAGNOSTICS=false
# Optional private directory. Defaults to cardano-ibc-gateway-diagnostics in the OS temp directory.
# GATEWAY_DEBUG_DIAGNOSTICS_DIR=/path/to/private/gateway-diagnostics

# Set false for a standalone Gateway using remotely hosted Cardano APIs.
# Caribic's local stack uses its existing external Docker network.
CARDANO_DOCKER_NETWORK_EXTERNAL=true

# Gateway application database for tree state and derived caches.
# Never use Yaci PostgreSQL credentials.
GATEWAY_DB_HOST=postgres
GATEWAY_DB_PORT=5432
GATEWAY_DB_NAME=gateway_app
GATEWAY_DB_USERNAME=postgres
GATEWAY_DB_PASSWORD=v8hlDV0yMAHHlIurYupj
GATEWAY_DB_SYNCHRONIZE=true

# Local devnet defaults. For external Cardano networks such as preprod/preview,
# replace these with externally reachable endpoints before starting the Gateway.
# Use "local" only for the local devnet. Public Cardano networks such as
# preprod/preview require "remote" with an externally reachable Kupo endpoint.
CARDANO_KUPO_MODE=
# Legacy alias kept for existing preprod env files; CARDANO_KUPO_MODE is preferred.
PREPROD_KUPO_MODE=
KUPO_ENDPOINT=http://kupo:1442
# Optional API-key headers for managed endpoints. Unauthenticated Demeter host
# forms require these; authenticated key-in-hostname URLs do not. Other
# providers follow their own authentication requirements.
KUPO_API_KEY=
OGMIOS_API_KEY=
# Optional runtime override for the Gateway container.
GATEWAY_RUNTIME_KUPO_ENDPOINT=
GATEWAY_RUNTIME_KUPO_API_KEY=
# Ogmios has no local/remote mode switch: the local container below only exists
# on the local devnet. For preprod/preview, replace this with your hosted Ogmios
# URL (required with CARDANO_KUPO_MODE=remote; the docker default is rejected).
OGMIOS_ENDPOINT=http://cardano-node-ogmios:1337
# Standard Yaci REST base URL. CF only needs to expose this API.
# Requires retained block CBOR from the manifest checkpoint.
# Provider settings: store.blocks.save-cbor=true and store.cardano.return-block-cbor=true.
# Retain historical spends with store.utxo.pruning-enabled=false.
YACI_STORE_ENDPOINT=http://yaci-store:8080
ENTRYPOINT_REST_ENDPOINT=
LOCAL_OSMOSIS_REST_ENDPOINT=
SWAP_ROUTER_ADDRESS=

# Will disappear in the future, once the relayer is able to sign transactions itself.
# This seed is for testing purposes only. Never use it in production!
SIGNER_WALLET_SEED="direct language gravity into finger nurse rug rug spoon toddler music ability brisk wasp sound ball join guard pattern smooth lemon obscure raise royal"

# Bech32 private key for paying transaction fees (devnet only).
# Uses the same key as `chains/cardano/config/credentials/me.sk`.
DEPLOYER_SK=

CARDANO_CHAIN_HOST=cardano-node
CARDANO_CHAIN_PORT=3001

# Public-network Yaci bootstrap checkpoint. Resolve these once before starting
# Yaci, typically to an epoch-boundary block 1-2 epochs before bridge deployment.
# Local devnet can leave them unset/zero.
YACI_SYNC_START_SLOT=0
YACI_SYNC_START_BLOCKHASH=
YACI_SYNC_START_BLOCK_NO=

CARDANO_CHAIN_ID=cardano-devnet
CARDANO_NETWORK_MAGIC=42
# Maximum accepted Cardano clock lead over the Cosmos host, in seconds.
CARDANO_CLIENT_MAX_CLOCK_DRIFT_SECONDS=10
# Required for probabilistic bootstrap. Use the network's Praos window for the
# starting era, 3*k/f in Babbage or 4*k/f in Conway. Caribic supplies the local value.
CARDANO_RANDOMNESS_STABILISATION_WINDOW_SLOTS=
# Independent trusted pool registry at the exact settled bootstrap point.
# See cosmos/cardano-probabilistic-light-client-core/POOL_REGISTRY.md.
CARDANO_POOL_REGISTRY_CHECKPOINT_FILE=
CARDANO_EPOCH_NONCE_GENESIS="f88a23a3fb200bc98ebe995d75e93770a79ab4ed85207737bac6205f2ac8e3ef"
# Public networks use Blockfrost for epoch and pool history. Local devnet uses Yaci and Ogmios.
# Leave the endpoint empty to use the network's hosted Blockfrost URL.
CARDANO_BLOCKFROST_ENDPOINT=
# Required for hosted Blockfrost, sent in the project_id header.
CARDANO_BLOCKFROST_PROJECT_ID=
CARDANO_STABILITY_THRESHOLD_DEPTH=10
CARDANO_STABILITY_THRESHOLD_UNIQUE_POOLS=2
CARDANO_STABILITY_THRESHOLD_UNIQUE_STAKE_BPS=6000
# Each update reserves capacity for a two-header challenge on the local v8/v10
# profiles. The destination enforces the 2.5 MiB maximum even if this is raised.
# Checkpoints authenticate chain progress but do not renew client trust.
CARDANO_STABILITY_CHECKPOINT_MAX_BRIDGE_BLOCKS=96
CARDANO_STABILITY_CHECKPOINT_MAX_HEADER_BYTES=2621440

HANDLER_JSON_PATH=/usr/src/app/cardano/offchain/deployments/handler.json

# Maximum cold-start wait for retained history, providers and verified IBC tree state.
BRIDGE_HISTORY_SYNC_TIMEOUT_SECONDS=7200
