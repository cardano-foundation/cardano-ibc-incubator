PORT=8000
GRPC_HOST=0.0.0.0
GRPC_PORT=5001

# Historical backend database (Yaci-backed bridge history).
HISTORY_DB_HOST=yaci-store-postgres
HISTORY_DB_PORT=5432
HISTORY_DB_NAME=yaci_store
HISTORY_DB_USERNAME=yaci
HISTORY_DB_PASSWORD=dbpass

# Gateway Application Database (read/write)
GATEWAY_DB_HOST=postgres
GATEWAY_DB_PORT=5432
GATEWAY_DB_NAME=gateway_app
GATEWAY_DB_USERNAME=postgres
GATEWAY_DB_PASSWORD=v8hlDV0yMAHHlIurYupj
GATEWAY_DB_SYNCHRONIZE=true

# Local devnet defaults. For external Cardano networks such as preprod/preview,
# replace these with externally reachable endpoints before starting the Gateway.
# Use "local" only for the local devnet. Public Cardano networks such as
# preprod/preview require "remote" with an externally reachable Kupo endpoint.
CARDANO_KUPO_MODE=
# Legacy alias kept for existing preprod env files; CARDANO_KUPO_MODE is preferred.
PREPROD_KUPO_MODE=
KUPO_ENDPOINT=http://kupo:1442
# Optional API-key headers for managed endpoints. Unauthenticated Demeter host
# forms require these; authenticated key-in-hostname URLs do not. Other
# providers follow their own authentication requirements.
KUPO_API_KEY=
OGMIOS_API_KEY=
# Optional runtime override for the Gateway container.
GATEWAY_RUNTIME_KUPO_ENDPOINT=
GATEWAY_RUNTIME_KUPO_API_KEY=
# Ogmios has no local/remote mode switch: the local container below only exists
# on the local devnet. For preprod/preview, replace this with your hosted Ogmios
# URL (required with CARDANO_KUPO_MODE=remote; the docker default is rejected).
OGMIOS_ENDPOINT=http://cardano-node-ogmios:1337
YACI_STORE_ENDPOINT=http://yaci-store:8080
ENTRYPOINT_REST_ENDPOINT=
LOCAL_OSMOSIS_REST_ENDPOINT=
SWAP_ROUTER_ADDRESS=

# Will disappear in the future, once the relayer is able to sign transactions itself.
# This seed is for testing purposes only. Never use it in production!
SIGNER_WALLET_SEED="direct language gravity into finger nurse rug rug spoon toddler music ability brisk wasp sound ball join guard pattern smooth lemon obscure raise royal"

# Bech32 private key for paying transaction fees (devnet only).
# Uses the same key as `chains/cardano/config/credentials/me.sk`.
DEPLOYER_SK=

CARDANO_CHAIN_HOST=cardano-node
CARDANO_CHAIN_PORT=3001

# Public-network Yaci bootstrap checkpoint. Resolve these once before starting
# Yaci, typically to an epoch-boundary block 1-2 epochs before bridge deployment.
# Local devnet can leave them unset/zero.
YACI_SYNC_START_SLOT=0
YACI_SYNC_START_BLOCKHASH=
YACI_SYNC_START_BLOCK_NO=

CARDANO_CHAIN_ID=cardano-devnet
CARDANO_NETWORK_MAGIC=42
CARDANO_LIGHT_CLIENT_MODE=stake-weighted-stability
# Maximum accepted Cardano clock lead over the Cosmos host, in seconds.
CARDANO_CLIENT_MAX_CLOCK_DRIFT_SECONDS=10
CARDANO_EPOCH_NONCE_GENESIS="f88a23a3fb200bc98ebe995d75e93770a79ab4ed85207737bac6205f2ac8e3ef"
# Optional Koios endpoints for public-network epoch nonces and pool registration history.
# Preprod/preview default to their public Koios URLs when CARDANO_NETWORK_MAGIC is 1/2.
CARDANO_EPOCH_PARAMS_ENDPOINT=
CARDANO_POOL_REGISTRATION_HISTORY_ENDPOINT=
# Optional Koios API token, sent as: Authorization: Bearer <token>
CARDANO_KOIOS_API_KEY=
CARDANO_STABILITY_THRESHOLD_DEPTH=10
CARDANO_STABILITY_THRESHOLD_UNIQUE_POOLS=2
CARDANO_STABILITY_THRESHOLD_UNIQUE_STAKE_BPS=6000
# Rootless catch-up headers are kept below the destination node's transaction
# limit. Checkpoints authenticate chain progress but do not renew client trust.
CARDANO_STABILITY_CHECKPOINT_MAX_BRIDGE_BLOCKS=32
CARDANO_STABILITY_CHECKPOINT_MAX_HEADER_BYTES=786432

HANDLER_JSON_PATH=/usr/src/app/cardano/offchain/deployments/handler.json

# The loaded bridge manifest selects the Tendermint client protocol and binds it
# to the deployed spend-client script. Proof-based deployments also require the
# prover service: docker compose --profile sp1 up -d.
SP1_TENDERMINT_PROVER_ENDPOINT=http://sp1-tendermint-prover:8080
SP1_TENDERMINT_PROVER_TIMEOUT_MS=7200000
# Local compose builds this tag. Production deployments should replace it with
# ghcr.io/cardano-foundation/cardano-ibc-incubator/sp1-tendermint-prover@sha256:<published-digest>.
SP1_TENDERMINT_PROVER_IMAGE=cardano-ibc-sp1-tendermint-prover:local
# Host directory containing outer.r1cs, outer.pk, outer.vk, and manifest.json
# for the exact wrapper verification key deployed on Cardano.
CARDANO_BLS_WRAPPER_KEYS_HOST_PATH=../sp1-tendermint-prover/keys-local
# `cpu` proves locally. `network` starts a paid Succinct proving-network job
# and never falls back to a second backend. An ambiguous SDK transport retry
# can still create a duplicate paid job; see the SP1 study's operational note.
SP1_TENDERMINT_PROVER_BACKEND=cpu
SP1_TENDERMINT_NETWORK_MODE=mainnet
SP1_TENDERMINT_NETWORK_PROOF_TIMEOUT_SECS=600
SP1_TENDERMINT_NETWORK_AUCTION_TIMEOUT_SECS=30
SP1_TENDERMINT_NETWORK_MIN_AUCTION_PERIOD_SECS=1
# Required for `network` + `mainnet`. The value is raw 18-decimal PROVE base
# units per PGU and must be at most 18446744073 with SP1 6.1.
SP1_TENDERMINT_NETWORK_MAX_PRICE_PER_PGU=
# The funded Succinct network signer. It is not needed by the CPU backend. In
# production, leave this empty and point NETWORK_PRIVATE_KEY_FILE at a secret
# file mounted inside the prover container. Set only one of these variables.
NETWORK_PRIVATE_KEY=
NETWORK_PRIVATE_KEY_FILE=
# Optional. Leave empty to use the selected network mode's standard RPC URL.
NETWORK_RPC_URL=
# The large wrapper keys are loaded once at service startup. Each subsequent
# wrapper proof has its own shorter timeout.
CARDANO_BLS_WRAPPER_STARTUP_TIMEOUT_SECS=600
CARDANO_BLS_WRAPPER_PROOF_TIMEOUT_SECS=120

MITHRIL_ENDPOINT=http://mithril-aggregator:8080/aggregator
MITHRIL_GENESIS_VERIFICATION_KEY=5b33322c3235332c3138362c3230312c3137372c31312c3131372c3133352c3138372c3136372c3138312c3138382c32322c35392c3230362c3130352c3233312c3135302c3231352c33302c37382c3231322c37362c31362c3235322c3138302c37322c3133342c3133372c3234372c3136312c36385d
